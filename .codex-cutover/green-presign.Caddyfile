{
	servers {
		trusted_proxies static 64.83.30.150
		trusted_proxies_strict
	}
}

(new_api_proxy) {
	request_body {
		max_size 100MB
	}

	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
		transport http {
			dial_timeout 30s
			read_timeout 600s
			write_timeout 600s
		}
	}
}

http://api.tryvalo.com, http://new.tryvalo.com {
	handle /.well-known/acme-challenge/* {
		reverse_proxy http://64.83.30.150:80 {
			header_up Host {host}
		}
	}

	handle {
		redir https://{host}{uri} 308
	}
}

api.tryvalo.com {
	import new_api_proxy
}

new.tryvalo.com {
	import new_api_proxy
}

origin-api.tryvalo.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	import new_api_proxy
}
